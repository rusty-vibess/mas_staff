TURTLEBOT_VERSION=1.0.0

# optional bootstrap settings; terminal environment values take precedence
BOOTSTRAP_VERSION=1.0.0
OPENCR_PORT=/dev/ttyACM0
OPENCR_MODEL=burger

# robot networking and lidar settings
ROS_DOMAIN_ID=111
ROBOT_NAME=tb_111
LDS_MODEL=LDS-02
LDS_DEVICE=/dev/ttyUSB0
TB_WATCHDOG=true
MANAGED_GATEWAY=true
