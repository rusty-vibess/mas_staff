# versioning; should match expected
PACKAGE_VERSION=1.2.0
BOOTSTRAP_VERSION=1.0.2
BRINGUP_VERSION=1.1.0

# ROS 2: Runtime config
ROS_DOMAIN_ID=30
# recommend tb_<NAME> (e.g. tb_111, tb_112, tb_james or tb_gary)
ROBOT_NAME=tb_NO_NAME

# TurtleBot: Hardware and device config
LDS_MODEL=LDS-02
LDS_DEVICE=/dev/ttyUSB0
OPENCR_PORT=/dev/ttyACM0
OPENCR_MODEL=burger
USE_OPENCR=true
# Camera defaults assume the Raspberry Pi 4 and IMX219 used at the time of writing
USE_CAMERA=false
CAMERA_DEVICE=/dev/video0
CAMERA_UNICAM_MEDIA_DEVICE=/dev/media1
CAMERA_ISP_MEDIA_DEVICE=/dev/media2

# Extra: Provides crash protection; if /cmd_vel recieves no update for 0.5s, set vel to 0.0
CMD_VEL_GUARD=true
# Extra: Provides UDP port manager; resolves unusual packet routes (e.g. Linux VM -> Host OS -> TB)
MANAGED_GATEWAY=false

# Remote image exchange API key (leave blank in the distributed package)
REMOTE_FILE_EXCHANGE_API_KEY=
